[
 {
  "doctype": "Custom Field",
  "dt": "Department",
  "fieldname": "custom_head",
  "label": "Head",
  "fieldtype": "Link",
  "options": "Employee",
  "insert_after": "payroll_cost_center",
  "name": "Department-custom_head"
 },
 {
  "doctype": "Custom Field",
  "dt": "Staffing Plan Detail",
  "fieldname": "custom_frozen_positions",
  "label": "Frozen Positions",
  "fieldtype": "Int",
  "default": "0",
  "insert_after": "vacancies",
  "name": "Staffing Plan Detail-custom_frozen_positions"
 },
 {
  "doctype": "Custom Field",
  "dt": "Skill",
  "fieldname": "custom_kind",
  "label": "Kind",
  "fieldtype": "Select",
  "options": "Audit\nTechnical review\nCalibration\nInspection",
  "insert_after": "description",
  "name": "Skill-custom_kind"
 },
 {
  "doctype": "Custom Field",
  "dt": "Skill",
  "fieldname": "custom_scheme",
  "label": "Scheme / Discipline",
  "fieldtype": "Data",
  "insert_after": "custom_kind",
  "name": "Skill-custom_scheme"
 },
 {
  "doctype": "Custom Field",
  "dt": "Skill",
  "fieldname": "custom_validity_months",
  "label": "Validity (months)",
  "fieldtype": "Int",
  "insert_after": "custom_scheme",
  "name": "Skill-custom_validity_months"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee",
  "fieldname": "custom_is_demo",
  "label": "Demo Record",
  "fieldtype": "Check",
  "default": "0",
  "insert_after": "status",
  "name": "Employee-custom_is_demo"
 },
 {
  "doctype": "Custom Field",
  "dt": "Goal",
  "fieldname": "custom_strategic_goal",
  "label": "Strategic Goal",
  "fieldtype": "Data",
  "insert_after": "kra",
  "name": "Goal-custom_strategic_goal"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Promotion",
  "fieldname": "custom_approved_by",
  "label": "Approved By",
  "fieldtype": "Link",
  "options": "User",
  "insert_after": "promotion_date",
  "read_only": 1,
  "no_copy": 1,
  "name": "Employee Promotion-custom_approved_by"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Transfer",
  "fieldname": "custom_approved_by",
  "label": "Approved By",
  "fieldtype": "Link",
  "options": "User",
  "insert_after": "transfer_date",
  "read_only": 1,
  "no_copy": 1,
  "name": "Employee Transfer-custom_approved_by"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Separation",
  "fieldname": "custom_approved_by",
  "label": "Approved By",
  "fieldtype": "Link",
  "options": "User",
  "insert_after": "boarding_begins_on",
  "read_only": 1,
  "no_copy": 1,
  "name": "Employee Separation-custom_approved_by"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Separation",
  "fieldname": "custom_reason",
  "label": "Reason for Leaving",
  "fieldtype": "Select",
  "options": "Resignation\nEnd of fixed-term contract\nRetirement\nDismissal\nDeath in service\nOther",
  "insert_after": "employee_name",
  "name": "Employee Separation-custom_reason"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Grievance",
  "fieldname": "custom_case_owner",
  "label": "Case Owner",
  "fieldtype": "Link",
  "options": "User",
  "insert_after": "status",
  "description": "Named HR Manager who handles it. Only they and HR Managers can read it.",
  "name": "Employee Grievance-custom_case_owner"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Grievance",
  "fieldname": "custom_next_step",
  "label": "Next Step",
  "fieldtype": "Data",
  "insert_after": "custom_case_owner",
  "name": "Employee Grievance-custom_next_step"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Grievance",
  "fieldname": "custom_next_step_due",
  "label": "Next Step Due",
  "fieldtype": "Date",
  "insert_after": "custom_next_step",
  "name": "Employee Grievance-custom_next_step_due"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employee Grievance",
  "fieldname": "custom_talk_first",
  "label": "Talk to HR Before Investigating",
  "fieldtype": "Check",
  "insert_after": "custom_next_step_due",
  "default": "0",
  "name": "Employee Grievance-custom_talk_first"
 },
 {
  "doctype": "Custom Field",
  "dt": "Designation",
  "fieldname": "custom_grade",
  "label": "Grade",
  "fieldtype": "Link",
  "options": "Employee Grade",
  "insert_after": "designation_name",
  "name": "Designation-custom_grade"
 }
]
