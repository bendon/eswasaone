  "name": "Designation-custom_grade"
 },
 {
  "doctype": "Custom Field",
  "dt": "User",
  "fieldname": "custom_hr_email_opt_out",
  "label": "No non-essential HR email",
  "fieldtype": "Check",
  "default": "0",
  "insert_after": "send_me_a_copy",
  "description": "Skip HR reminders by email. Leave decisions and job offers are always sent.",
  "name": "User-custom_hr_email_opt_out"
 },
 {
  "doctype": "Custom Field",
  "dt": "HR Settings",
  "fieldname": "custom_receipt_required_above",
  "label": "Receipt required above",
  "fieldtype": "Currency",
  "insert_after": "expense_approver_mandatory_in_expense_claim",
  "description": "Expense claim lines above this amount need a receipt. Leave empty to require a receipt on every line (set by ESWASA Finance).",
  "name": "HR Settings-custom_receipt_required_above"
 },
 {
  "doctype": "Custom Field",
  "dt": "Expense Claim Detail",
  "fieldname": "custom_receipt",
  "label": "Receipt",
  "fieldtype": "Data",
  "insert_after": "description",
  "description": "File name of the receipt attached to the claim.",
  "in_list_view": 0,
  "name": "Expense Claim Detail-custom_receipt"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Requisition",
  "fieldname": "custom_stage",
  "label": "Approval stage",
  "fieldtype": "Select",
  "options": "\nHead\nHR\nDone",
  "insert_after": "status",
  "read_only": 1,
  "description": "Head of department, then HR (brief \u00a712.1). Set by EswasaOne.",
  "name": "Job Requisition-custom_stage"
 },
 {
  "doctype": "Custom Field",
  "dt": "HR Settings",
  "fieldname": "custom_offer_signatory_role",
  "label": "Offer letter signatory",
  "fieldtype": "Select",
  "options": "\nEswasa Executive Director\nHR Manager",
  "insert_after": "custom_receipt_required_above",
  "description": "Who signs offer letters (Confirmation Pack H3). Empty: letters say the signatory is awaiting ESWASA.",
  "name": "HR Settings-custom_offer_signatory_role"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "custom_source",
  "label": "Source",
  "fieldtype": "Select",
  "options": "\nCareers\nDirect",
  "insert_after": "status",
  "read_only": 1,
  "description": "Direct: created by EswasaOne to onboard someone hired outside Recruitment.",
  "name": "Job Applicant-custom_source"
 },
 {
  "doctype": "Custom Field",
  "dt": "Employment Type",
  "fieldname": "custom_required_documents",
  "label": "Required Documents",
  "fieldtype": "Table",
  "options": "Required Document",
