[
  {
    "doctype": "Print Format",
    "name": "Certificate of Conformity",
    "doc_type": "Certificate",
    "module": "Certification",
    "standard": "No",
    "custom_format": 1,
    "print_format_type": "Jinja",
    "default_print_language": "en",
    "font": "Default",
    "margin_top": 10,
    "margin_bottom": 10,
    "margin_left": 12,
    "margin_right": 12,
    "html": "<div style=\"font-family: 'Times New Roman', Georgia, serif; color: #1a1a1a; max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem; border: 2px solid #0b3d2e;\">\n  <div style=\"text-align: center; border-bottom: 1px solid #c5a24a; padding-bottom: 1rem; margin-bottom: 1.5rem;\">\n    <div style=\"font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: #0b3d2e;\">Eswatini Standards Authority</div>\n    <h1 style=\"margin: 0.4rem 0 0; font-size: 1.6rem; font-weight: 700; color: #0b3d2e;\">Certificate of Conformity</h1>\n    <p style=\"margin: 0.35rem 0 0; font-size: 0.85rem; color: #555;\">ISO/IEC 17021 / 17065 certification body</p>\n  </div>\n  <p style=\"text-align: center; font-size: 0.95rem;\">This is to certify that</p>\n  <p style=\"text-align: center; font-size: 1.35rem; font-weight: 700; margin: 0.75rem 0;\">{{ doc.holder_name }}</p>\n  <p style=\"text-align: center; font-size: 0.95rem;\">has been assessed and found to conform to</p>\n  <p style=\"text-align: center; font-size: 1.1rem; font-weight: 600; margin: 0.75rem 0;\">{{ frappe.db.get_value(\"Certification Scheme\", doc.scheme, \"standard_ref\") or doc.scheme }}</p>\n  {% if doc.scope_summary %}\n  <div style=\"margin: 1.25rem 0; padding: 0.75rem 1rem; background: #f7f5ef; border-left: 3px solid #c5a24a;\">\n    <div style=\"font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: #666;\">Scope</div>\n    <div style=\"margin-top: 0.35rem; white-space: pre-wrap;\">{{ doc.scope_summary }}</div>\n  </div>\n  {% endif %}\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 1.5rem;\">\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Certificate No.</td>\n      <td style=\"padding: 0.35rem 0; text-align: right; font-weight: 600;\">{{ doc.certificate_number }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Document</td>\n      <td style=\"padding: 0.35rem 0; text-align: right;\">{{ doc.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Scheme</td>\n      <td style=\"padding: 0.35rem 0; text-align: right;\">{{ doc.scheme }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Status</td>\n      <td style=\"padding: 0.35rem 0; text-align: right;\">{{ doc.status }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Issued</td>\n      <td style=\"padding: 0.35rem 0; text-align: right;\">{{ frappe.format(doc.issued_on, {'fieldtype': 'Date'}) }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Valid until</td>\n      <td style=\"padding: 0.35rem 0; text-align: right;\">{{ frappe.format(doc.valid_until, {'fieldtype': 'Date'}) }}</td>\n    </tr>\n    {% if doc.verification_token %}\n    <tr>\n      <td style=\"padding: 0.35rem 0; color: #666;\">Verification</td>\n      <td style=\"padding: 0.35rem 0; text-align: right; font-family: monospace; font-size: 0.8rem;\">{{ doc.verification_token }}</td>\n    </tr>\n    {% endif %}\n  </table>\n  {% if doc.qr_payload %}\n  <div style=\"margin-top: 1.5rem; text-align: center; font-size: 0.8rem; color: #444;\">\n    <div style=\"letter-spacing: 0.12em; text-transform: uppercase; color: #666; font-size: 0.65rem;\">Scan / verify</div>\n    <div style=\"margin-top: 0.35rem; word-break: break-all;\">{{ doc.qr_payload }}</div>\n  </div>\n  {% endif %}\n  <p style=\"margin-top: 2rem; font-size: 0.75rem; color: #777; text-align: center;\">Stub print format. Verify accreditation marks and signatures before production use.</p>\n</div>"
  }
]
