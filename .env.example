# EswasaOne — environment template (copy to .env; never commit secrets)

# --- Public ---
PUBLIC_HOST=eswasaone.aiceafrica.com
PUBLIC_BASE_URL=https://eswasaone.aiceafrica.com

# --- Port block 15 (bind 127.0.0.1) ---
SERVICE_PORTAL_PORT=3015
INSTITUTION_PORTAL_PORT=3016
FIELD_PORTAL_PORT=3017
CORE_PORT=8015
INGEST_HEALTH_PORT=8016
FRAPPE_HTTP_PORT=8020
FRAPPE_SOCKETIO_PORT=9020

# --- Shared MariaDB ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eswasaone
MYSQL_USER=eswasaone
MYSQL_PASSWORD=change-me

# --- Shared Redis (db index 15; host uses requirepass — set via REDIS_PASSWORD) ---
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/15

# --- Shared Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_PREFIX=eswasaone_

# --- Frappe site (engine) ---
FRAPPE_SITE=eswasaone.localhost
FRAPPE_URL=http://127.0.0.1:8020
FRAPPE_ADMIN_USER=Administrator
FRAPPE_ADMIN_PASSWORD=change-me

# --- Auth / identity checklist (roster A7) ---
# FRAPPE_GUEST_API_KEY / FRAPPE_GUEST_API_SECRET — required for anonymous guide/catalogue
# CORE_TOKEN_ENCRYPTION_KEY — encrypt Frappe tokens at rest in Redis sessions
# SMTP_* — required for real OTP email (else OTP stubbed to logs)
# CORE_ALLOW_MOCK_AUTH=false  # true only for offline smoke; when Frappe is up, bad login/register must 401/409

# Guest read-only service account (anonymous guide / catalogue / applicability)
FRAPPE_GUEST_USER=eswasaone.guest
FRAPPE_GUEST_API_KEY=
FRAPPE_GUEST_API_SECRET=

# Core session crypto (encrypt Frappe tokens at rest)
CORE_TOKEN_ENCRYPTION_KEY=
# --- Core ---
CORE_SECRET_KEY=change-me-session-secret
CORE_CORS_ORIGINS=https://eswasaone.aiceafrica.com,http://127.0.0.1:3015,http://127.0.0.1:3016

# --- Portals (Vite reads this repo-root .env via envDir) ---
VITE_API_BASE=/api
# Dev only: where each portal's Vite proxy sends /api + /ws (default http://127.0.0.1:${CORE_PORT}).
# API_PROXY_TARGET is still accepted as an alias.
# CORE_PROXY_TARGET=https://eswasaone.aiceafrica.com
# Optional: override WebSocket (default derives from window.location)
# VITE_WS_BASE=wss://eswasaone.aiceafrica.com/ws
VITE_WS_BASE=wss://eswasaone.aiceafrica.com/ws
# Fixture data + disabled writes — production/staging must be false or unset
VITE_DEMO_MODE=false
# Desk deep-links (admins / localhost only; not public on aiceafrica.com)
# VITE_DESK_URL=http://127.0.0.1:8020
# VITE_FRAPPE_URL=http://127.0.0.1:8020

# --- LLM (agent) ---
LLM_API_KEY=
LLM_MODEL=

# --- Adapters (WS6) — stubs when empty ---
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=https://eswasaone.aiceafrica.com/api/adapters/momo/callback
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MOMO_TARGET_ENVIRONMENT=sandbox
# MOMO_CURRENCY=SZL

# TBT handoff (optional; stub if empty)
# TBT_HANDOFF_URL=

# Messaging (console/log fallback if empty) — shared by Core OTP and Frappe Email Account
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=EswasaOne Admin
# SMTP_USE_TLS=true
# After setting SMTP_*: run engine/fixtures/configure_smtp.py as user frappe
# SMS_API_URL=
# SMS_API_KEY=
# WHATSAPP_API_URL=
# WHATSAPP_TOKEN=
# WHATSAPP_FROM=

# --- Ingest ---
INGEST_OBJECT_STORE_PATH=/var/lib/eswasaone/ingest

# --- Media / documents (uploads + generated PDFs) ---
# Local fallback when S3_* is empty (natively hosted; no Docker required)
MEDIA_LOCAL_PATH=/var/lib/eswasaone/media
# S3-compatible (AWS / MinIO / Cloudflare R2). When bucket+keys set, Core uses S3.
# S3_ENDPOINT_URL=https://minio.example.com
# S3_BUCKET=eswasaone-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=af-south-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com/eswasaone

# --- Frappe → Core live feed (WebSocket bridge) ---
# In site_config.json set: "eswasaone_core_url": "http://127.0.0.1:8015"
# Apps POST to /api/events/webhooks/eswasa_feed → Institution /ws/feed subscribers
